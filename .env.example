# ─── LUMINA FRAMEWORK CONFIGURATION ──────────────────────────────────────────

# Application Settings
APP_NAME=Lumina
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=lumina-super-secret-key-change-me-in-production

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Database Configuration (Multi-Driver: sqlite / postgres / mysql)
DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_paguyuban
DB_USERNAME=postgres
DB_PASSWORD=

# Atau gunakan URL eksplisit:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/paguyuban
# DATABASE_URL=sqlite:./database.sqlite
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/my_db

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Storage Settings
UPLOAD_MAX_SIZE_MB=5

# Session Configuration
JWT_SECRET=lumina-jwt-secret-key-change-me-in-production

# ──────────────────────────────────────────────────────────────────────────────
